{
  "name": "fornello",
  "version": "1.0.0",
  "private": true,
  "main": "electron.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac --dir",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "build:app": "node scripts/build-app.mjs",
    "sync:app": "npm run build:app && npx cap sync ios",
    "test:safety": "npx --yes tsx scripts/safety-suite.mjs",
    "test:photo-match": "npx --yes tsx scripts/photo-match-test.mjs",
    "test:cron": "node scripts/cron-coverage.mjs",
    "photos": "npx --yes tsx scripts/photo-coverage.mjs",
    "test:translate": "npx --yes tsx scripts/translate-test.mjs",
    "test:day-offers": "npx --yes tsx scripts/day-offers-test.mjs",
    "test:week-one": "npx --yes tsx scripts/week-one-test.mjs",
    "test:week-start": "npx --yes tsx scripts/week-start-test.mjs",
    "test:vessel": "npx --yes tsx scripts/vessel-test.mjs",
    "test:relock": "node scripts/relock-test.mjs",
    "test:launch": "node scripts/launch-gate-test.mjs",
    "test:lock": "node scripts/lock-gate-test.mjs",
    "test:share-list": "npx --yes tsx scripts/share-list-test.mjs",
    "week-one:who": "npx --yes tsx scripts/week-one-preview.mjs",
    "prebuild": "node scripts/cron-coverage.mjs"
  },
  "build": {
    "appId": "com.fornello.app",
    "productName": "Fornello",
    "asar": false,
    "mac": {
      "category": "public.app-category.food-and-drink",
      "icon": "public/icon.icns"
    },
    "files": [
      "**/*",
      "!**/*.ts",
      "!**/*.tsx",
      "!.next/cache",
      "!scripts"
    ],
    "npmRebuild": false,
    "fileAssociations": [
      {
        "ext": "fornello",
        "name": "Fornello Recipe",
        "description": "Fornello Recipe File",
        "mimeType": "application/x-fornello",
        "icon": "public/icon.icns"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfmake": "^0.3.2",
    "@vercel/functions": "^3.9.5",
    "next": "16.2.4",
    "nodemailer": "^8.0.5",
    "pdfmake": "^0.3.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
